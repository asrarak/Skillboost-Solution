# 1. Setting Variables
echo "Step 1: Exporting environment variables..."
export CUSTOM_ROLE=
export S_A=
export CLUSTER=
export ZONE=

# 2. Configure Compute Zone
echo "Step 2: Setting default compute zone to $ZONE..."
gcloud config set compute/zone $ZONE

# 3. Create Custom Role Definition
echo "Step 3: Creating IAM role definition file (role-definition.yaml)..."
cat > role-definition.yaml <<EOF_END
title: "$CUSTOM_ROLE"
description: "Permissions for Orca Storage access"
stage: "ALPHA"
includedPermissions:
- storage.buckets.get
- storage.objects.get
- storage.objects.list
- storage.objects.update
- storage.objects.create
EOF_END

# 4. Create Custom Role and Service Account
echo "Step 4: Creating custom IAM role: $CUSTOM_ROLE..."
gcloud iam roles create $CUSTOM_ROLE --project $DEVSHELL_PROJECT_ID --file role-definition.yaml

echo "Step 5: Creating Service Account: $S_A..."
gcloud iam service-accounts create $S_A --display-name "Orca Private Cluster Service Account"

# 5. Bind IAM Policies
echo "Step 6: Binding Monitoring Viewer role..."
gcloud projects add-iam-policy-binding $DEVSHELL_PROJECT_ID --member serviceAccount:$S_A@$DEVSHELL_PROJECT_ID.iam.gserviceaccount.com --role roles/monitoring.viewer

echo "Step 7: Binding Monitoring Metric Writer role..."
gcloud projects add-iam-policy-binding $DEVSHELL_PROJECT_ID --member serviceAccount:$S_A@$DEVSHELL_PROJECT_ID.iam.gserviceaccount.com --role roles/monitoring.metricWriter

echo "Step 8: Binding Logging Log Writer role..."
gcloud projects add-iam-policy-binding $DEVSHELL_PROJECT_ID --member serviceAccount:$S_A@$DEVSHELL_PROJECT_ID.iam.gserviceaccount.com --role roles/logging.logWriter

echo "Step 9: Binding Custom Role $CUSTOM_ROLE to Service Account..."
gcloud projects add-iam-policy-binding $DEVSHELL_PROJECT_ID --member serviceAccount:$S_A@$DEVSHELL_PROJECT_ID.iam.gserviceaccount.com --role projects/$DEVSHELL_PROJECT_ID/roles/$CUSTOM_ROLE

# 6. Create GKE Cluster
echo "Step 10: Creating Private GKE Cluster: $CLUSTER (This will take 5-10 minutes)..."
gcloud container clusters create $CLUSTER \
  --num-nodes 1 \
  --master-ipv4-cidr=172.16.0.64/28 \
  --network orca-build-vpc \
  --subnetwork orca-build-subnet \
  --enable-master-authorized-networks \
  --master-authorized-networks 192.168.10.2/32 \
  --enable-ip-alias \
  --enable-private-nodes \
  --enable-private-endpoint \
  --service-account $S_A@$DEVSHELL_PROJECT_ID.iam.gserviceaccount.com \
  --zone $ZONE

# 7. Jumpbox Execution
echo "Step 11: Connecting to jumphost to deploy application..."
gcloud compute ssh --zone "$ZONE" "orca-jumphost" --project "$DEVSHELL_PROJECT_ID" --quiet --command "
  echo 'Inside Jumphost: Setting zone...' && \
  gcloud config set compute/zone $ZONE && \
  echo 'Inside Jumphost: Fetching cluster credentials...' && \
  gcloud container clusters get-credentials $CLUSTER --internal-ip && \
  echo 'Inside Jumphost: Installing auth plugin...' && \
  sudo apt-get install google-cloud-sdk-gke-gcloud-auth-plugin -y && \
  echo 'Inside Jumphost: Deploying hello-server...' && \
  kubectl create deployment hello-server --image=gcr.io/google-samples/hello-app:1.0 && \
  echo 'Inside Jumphost: Exposing service...' && \
  kubectl expose deployment hello-server --name orca-hello-service --type LoadBalancer --port 80 --target-port 8080
"

echo "Process Complete! Your private cluster is configured and the service is being exposed."
